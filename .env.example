# PROOF — copy to .env / platform secrets. Never commit real values.

SESSION_SECRET=replace-with-long-random-string
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini-serv-multipath
SERV_BASE_URL=https://inference-api.openserv.ai/v1

CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_EVM_ADDRESS=
CDP_ACCOUNT_NAME=proof-spender

PROOF_NETWORK=base-sepolia

# Optional — public demo payee (full 0x address; not a secret)
PROOF_DEMO_PAYEE=

# Optional — Bearer key for POST /api/v1/evaluate (agent callers)
PROOF_AGENT_API_KEY=

# Optional — Plausible domain for consented analytics (else first-party beacon)
VITE_PUBLIC_ANALYTICS_DOMAIN=

# Optional — factcheck / research (server-only)
TINYFISH_API_KEY=
TAVILY_API_KEY=

# Optional — AgentRouter backup LLM (NOT a SERV substitute). Cloud IPs need Tor.
# See docs/memory/AGENTROUTER_SETUP.md
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=deepseek-v4-flash
AGENTROUTER_USE_TOR=1
AGENTROUTER_TOR_SOCKS=socks5h://127.0.0.1:9050
